# ═══════════════════════════════════════════════════════════════════════════════
# Stratoscan — LOCAL stack configuration (docker compose, repo root)
# ═══════════════════════════════════════════════════════════════════════════════
#
#   cp .env.local.example .env.local
#   make up
#
# Every host name below (`postgres`, `redis`, `redis-http`) resolves ONLY inside
# the compose network — that is deliberate, and it is what makes it structurally
# hard to point this file at production by accident.
#
# This file mirrors the key set and comment style of stratoscan/.env.example so
# the configuration contract stays recognisable. Where a value is deliberately
# different for local use, the comment says why. `.env.local` is git-ignored.
# ═══════════════════════════════════════════════════════════════════════════════

# ── The three logical databases ───────────────────────────────────────────────
# One local Postgres server hosts all three (see scripts/initdb.sql). Production
# uses three separate Neon projects — one per DSN. Keeping the three DSNs
# genuinely distinct here is the point: a query that reaches the wrong database
# fails locally rather than on deploy.
DATABASE_URL="postgresql://stratoscan:stratoscan@postgres:5432/stratoscan"
BACKTEST_DATABASE_URL="postgresql://stratoscan:stratoscan@postgres:5432/stratoscan_backtest"
NEWS_DATABASE_URL="postgresql://stratoscan:stratoscan@postgres:5432/stratoscan_news"

# ── Redis (Upstash REST, served locally by a proxy) ───────────────────────────
# src/redis_ratelimit.py speaks the Upstash REST protocol (/multi-exec,
# /pipeline, `Authorization: Bearer`) — not RESP. `redis-http` in
# docker-compose.yml translates REST -> real Redis so the Redis code path is
# actually exercised locally, instead of the app silently falling back to the
# in-memory store and looking healthy while that path goes untested.
REDIS_RATE_LIMIT_ENABLED="true"
UPSTASH_REDIS_REST_URL="http://redis-http:80"
# Must match SRH_TOKEN in docker-compose.yml.
UPSTASH_REDIS_REST_TOKEN="local-dev-token"
# Seconds per REST call (default 10.0).
#REDIS_RATE_LIMIT_TIMEOUT=10.0

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Left ON deliberately: the Redis-backed store is only resolved when the limiter
# actually runs, so turning the limiter off would hide the very thing this stack
# exists to exercise.
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_PER_MINUTE="60"
RATE_LIMIT_PER_DAY="1000"
RATE_LIMIT_BYPASS_IPS=""

# ── Authentication ────────────────────────────────────────────────────────────
# Any non-empty value works locally. /auth/* returns 503 without it.
JWT_SECRET="local-dev-jwt-secret-not-a-real-key"
JWT_EXPIRE_HOURS=168
PASSWORD_MIN_LENGTH=8

# ── Email ─────────────────────────────────────────────────────────────────────
# ⚠️  KNOWN GAP — stated plainly rather than papered over: the app sends mail via
# SendGrid's HTTP API (`POST https://api.sendgrid.com/v3/mail/send`, hardcoded in
# src/emails.py) and has NO SMTP path. mailpit runs in the stack (SMTP 1025, UI
# on http://localhost:8025) but NOTHING will arrive in it today — pointing the
# app at it requires an SMTP sender in src/, which task 005's non-goals forbid.
# With these blank, registration still works and reports `email_sent: false`.
SENDGRID_API_KEY=""
EMAIL_FROM_ADDRESS=""
APP_BASE_URL="http://localhost:5173"
EMAIL_VERIFICATION_REQUIRED=false
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24

# ── CORS ──────────────────────────────────────────────────────────────────────
# An explicit origin, never "*" — a wildcard does not work with credentialed
# requests, and the app would appear to reject the frontend.
CORS_ALLOW_ORIGINS="http://localhost:5173"

# ── Admin ─────────────────────────────────────────────────────────────────────
# Emails auto-promoted to admin at register/login. Empty = /admin/* returns 403
# to everyone (which is the correct default locally).
ADMIN_EMAILS=""

# ── Finnhub ───────────────────────────────────────────────────────────────────
# ⚠️  FINNHUB_KEY_01 must be NON-EMPTY, or the scheduler container exits at once.
# DataRefreshScheduler's constructor calls initialize_client_pool(), which raises
# `ValueError: No Finnhub API keys found. Set FINNHUB_KEY_01 through
# FINNHUB_KEY_10` on an empty key list — the process dies before it can run a
# single job, and `make verify` reports the scheduler as not running.
# (The API is unaffected: it boots and serves /health with no keys at all, because
# the screener makes 0 external API calls per query.)
#
# The placeholder below satisfies ONLY that constructor check — every refresh job
# will log 401s against a fake key. That is expected locally and visible in
# `make logs` / GET /ops/jobs. Replace it with a real free-tier key from
# https://finnhub.io/register when you want live data.
FINNHUB_KEY_01="local-placeholder-key-not-real"
FINNHUB_KEY_02=""
FINNHUB_KEY_03=""
FINNHUB_KEY_04=""
FINNHUB_KEY_05=""
FINNHUB_KEY_06=""
FINNHUB_KEY_07=""
FINNHUB_KEY_08=""
FINNHUB_KEY_09=""
FINNHUB_KEY_10=""
NEWS_FINNHUB_KEY=""
FINNHUB_REQUEST_TIMEOUT=30

# ── LLM providers ─────────────────────────────────────────────────────────────
# Also intentionally blank: the deterministic interpreter handles most queries at
# zero cost, and nothing in `make verify` needs an LLM. Without keys, a query the
# deterministic parser cannot handle returns an honest "could not interpret"
# rather than a wrong answer.
LLM_PROVIDERS="zai,gemini,groq"
ZAI_BASE_URL="https://api.z.ai/api/paas/v4/"
ZAI_MODEL="glm-4.5-flash"
ZAI_KEYS=""
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
GEMINI_MODEL="gemini-3-flash-preview"
GEMINI_KEYS=""
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_KEYS=""
LLM_PROVIDER_TIMEOUT=120
# Legacy single-provider fallback (see stratoscan/.env.example).
LLM_BASE_URL=""
LLM_MODEL=""
SCREENER_LLM_KEY=""
BACKTEST_LLM_KEY=""

# ── Runtime shape ─────────────────────────────────────────────────────────────
# development keeps /docs and /openapi.json available, which is what you want
# locally; production disables them.
APP_ENV="development"
LOG_LEVEL="INFO"
LOG_FORMAT="text"
LOG_FILE=""
METRICS_ENABLED=true
DB_CONNECT_TIMEOUT=15
YFINANCE_TIMEOUT=60

# ── Caching ───────────────────────────────────────────────────────────────────
CACHE_ENABLED=true
INTERPRET_CACHE_TTL=86400
INTERPRET_CACHE_MAX_ENTRIES=1024
SCREEN_CACHE_TTL=60
SCREEN_CACHE_MAX_ENTRIES=1024

# ── NL interpreter ────────────────────────────────────────────────────────────
USE_DETERMINISTIC_INTERPRETER=true

# ── Background job monitoring ─────────────────────────────────────────────────
JOB_MONITOR_ENABLED=true
JOB_HEARTBEAT_PERSIST_MINUTES=15

# ── News pipeline ─────────────────────────────────────────────────────────────
NEWS_SYMBOLS_LIMIT=150
NEWS_REFRESH_MINUTES=120
NEWS_LLM_PREFER="groq"

# ── Backtest cache warmer ─────────────────────────────────────────────────────
# Runs nightly at 03:30 and pulls 10y of history from yfinance. Enable only when
# you want the local backtest cache pre-filled (it is slow on a cold start).
BACKTEST_CACHE_WARMER_ENABLED=false
BACKTEST_CACHE_WARMER_LIMIT=100
BACKTEST_CACHE_WARMER_STALE_DAYS=2
BACKTEST_CACHE_WARMER_DELAY=0.2
BACKTEST_CACHE_WARMER_TIME=03:30

# ── Alerting (optional) ───────────────────────────────────────────────────────
# No-op unless one channel is configured. ALERT_WEBHOOK_MIN_INTERVAL_SECONDS
# defaults to 900 (15 min) and guards against alert storms.
#ALERT_WEBHOOK_URL="https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXX"
#ALERT_EMAIL="ops@stratoscan.com"
#ALERT_WEBHOOK_MIN_INTERVAL_SECONDS=900
