# ─────────────────────────────────────────────────────────────────────────────
# STAGING environment template (P0-0).
#
# Copy to `staging.env` (gitignored), fill in the real values, then run
# `python3 run_staging.py` (local) or deploy via fly.staging.toml (Fly).
#
# RATE_LIMIT_ENABLED / REDIS_RATE_LIMIT_ENABLED are FALSE here so E2E tests
# and release-gate probes never trip 429s on staging.
#
# DATABASE_URL must point at the `stratoscan_staging` database in the same
# Neon project as production (created by P0-0). swap the db path only —
# keep the username/password/host identical to production.
# ─────────────────────────────────────────────────────────────────────────────

# ── Data providers (shared with prod — read-scoped, no extra cost) ─────────
FINNHUB_KEY_01="<finnhub-key>"
FINNHUB_KEY_02=""
FINNHUB_KEY_03=""
FINNHUB_KEY_04=""
FINNHUB_KEY_05=""
FINNHUB_KEY_06=""
FINNHUB_KEY_07=""
FINNHUB_KEY_08=""
FINNHUB_KEY_09=""
FINNHUB_KEY_10=""

# ── LLM providers ───────────────────────────────────────────────────────────
LLM_PROVIDERS="zai"
ZAI_BASE_URL="https://api.z.ai/api/v1"
ZAI_MODEL="glm-4.7-flash-free"
ZAI_KEYS="<key>"
GEMINI_BASE_URL=""
GEMINI_MODEL=""
GEMINI_KEYS=""
GROQ_BASE_URL=""
GROQ_MODEL=""
GROQ_KEYS=""
LLM_BASE_URL=""
LLM_MODEL=""
SCREENER_LLM_KEY="<key>"
BACKTEST_LLM_KEY="<key>"
LLM_PROVIDER_TIMEOUT="120.0"

# ── Databases ───────────────────────────────────────────────────────────────
# MUST point at stratoscan_staging (same project/host/user as prod).
DATABASE_URL="postgresql://<user>:<password>@<host>.neon.tech/stratoscan_staging?sslmode=require"
# DEDICATED probes DB (P0-12): where the 15 verify_*.py behavior probes run.
# Same host/user/password as DATABASE_URL, database path = stratoscan_probes.
# Seed it with `python3 seed_probes_db.py` (100 top + 20 random + real SPY).
STAGING_DATABASE_URL="postgresql://<user>:<password>@<host>.neon.tech/stratoscan_probes?sslmode=require"
# News + backtest projects are shared with prod (read-mostly; staging writes
# go to the staging stock_master only).
NEWS_DATABASE_URL="postgresql://<user>:<password>@<news-host>.neon.tech/neondb?sslmode=require"
BACKTEST_DATABASE_URL="postgresql://<user>:<password>@<backtest-host>.neon.tech/neondb?sslmode=require"
NEWS_FINNHUB_KEY="<key>"
NEWS_SYMBOLS_LIMIT="150"
NEWS_REFRESH_MINUTES="60"
NEWS_LLM_PREFER="zai"

# ── Auth / app ──────────────────────────────────────────────────────────────
JWT_SECRET="<staging-jwt-secret>"
JWT_EXPIRE_HOURS="168"
# Comma-separated emails granted the admin role at register/login (bootstrap).
# The first admin must be listed here: sign up, and the app-shell nav shows
# the Admin dashboard link automatically (the auth response carries is_admin).
ADMIN_EMAILS="you@example.com"
PASSWORD_MIN_LENGTH="8"
APP_BASE_URL="http://localhost:5173"   # staging frontend origin (email links)
CORS_ALLOW_ORIGINS="http://localhost:5173,http://localhost:8010"

# ── Timeouts / caches ───────────────────────────────────────────────────────
FINNHUB_REQUEST_TIMEOUT="30.0"
YFINANCE_TIMEOUT="60.0"
DB_CONNECT_TIMEOUT="15"
CACHE_ENABLED="true"
INTERPRET_CACHE_TTL="3600"
INTERPRET_CACHE_MAX_ENTRIES="512"
SCREEN_CACHE_TTL="60"
SCREEN_CACHE_MAX_ENTRIES="512"

# ── Rate limiting: OFF on staging ──────────────────────────────────────────
RATE_LIMIT_ENABLED="false"
# Per-IP default caps (used if rate limiting is ever enabled on staging).
RATE_LIMIT_PER_MINUTE="60"
RATE_LIMIT_PER_DAY="1000"
REDIS_RATE_LIMIT_ENABLED="false"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL="info"
LOG_FORMAT="pretty"
LOG_FILE="staging_api_server.log"

# ── Supabase (legacy, optional) ────────────────────────────────────────────
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""
SUPABASE_ANON_KEY=""
