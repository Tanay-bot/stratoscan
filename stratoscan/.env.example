# ═══════════════════════════════════════════════════════════════════════════════
# Stratoscan — Environment Configuration (.env)
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your real API keys.
# ⚠️  NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Finnhub API Keys ─────────────────────────────────────────────────────────
# Sign up at https://finnhub.io/register (free tier = 60 req/min per key)
FINNHUB_KEY_01=""
FINNHUB_KEY_02=""
FINNHUB_KEY_03=""
FINNHUB_KEY_04=""
FINNHUB_KEY_05=""
FINNHUB_KEY_06=""
FINNHUB_KEY_07=""
FINNHUB_KEY_08=""
FINNHUB_KEY_09=""
FINNHUB_KEY_10=""

# ── LLM Providers (multi-provider instant failover) ─────────────────────────
# The interpreter routes through src/llm_router.py. LLM_PROVIDERS is a
# comma-separated priority list (first = primary). For each provider, define
# <NAME>_BASE_URL, <NAME>_MODEL and <NAME>_KEYS (comma-separated keys for
# round-robin). The router fails over instantly on 429/5xx/dead keys and
# cools down failing providers so they're skipped fast. Add as many keys and
# providers as you like — no code changes needed.
#
# Z.ai (free tier — GLM-4.5-Flash / GLM-4.7-Flash are $0 forever, no balance):
#   https://z.ai -> API Keys -> create key. Base URL below is OpenAI-compatible.
ZAI_BASE_URL="https://api.z.ai/api/paas/v4/"
ZAI_MODEL="glm-4.5-flash"
ZAI_KEYS="key1,key2,key3"

# ZAI_TIMEOUT=120 — per-provider call timeout (s); overrides LLM_PROVIDER_TIMEOUT.

# ZenMux (OpenAI-compatible gateway; free-tier models need balance > $0):
# ZENMUX_BASE_URL="https://zenmux.ai/api/v1"
# ZENMUX_MODEL="z-ai/glm-4.7-flash-free"
# ZENMUX_KEYS="sk-ai-v1-..."

# ZENMUX_TIMEOUT=120 — per-provider call timeout (s); overrides LLM_PROVIDER_TIMEOUT.

# Google Gemini (free tier ~1,500 RPD, no credit card):
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
GEMINI_MODEL="gemini-3-flash-preview"
GEMINI_KEYS="AIza..."

# GEMINI_TIMEOUT=120 — per-provider call timeout (s); overrides LLM_PROVIDER_TIMEOUT.

# Groq (free tier — 30 RPM / 1,000 req/day per account, no credit card):
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_KEYS="gsk_..."

# GROQ_TIMEOUT=120 — per-provider call timeout (s); overrides LLM_PROVIDER_TIMEOUT.

# ⚠️  Provider priority. First = primary; others are automatic fallbacks.
LLM_PROVIDERS="zai,gemini,groq"

# ── Backtesting LLM Key (separate, for future use) ───────────────────────────
BACKTEST_LLM_KEY=""

# ── Legacy single-provider fallback (optional) ──────────────────────────────
# When screener_llm_key + llm_base_url are set, the router builds ONE
# provider from these three keys (config.py + llm_router.py) — used when no
# provider in LLM_PROVIDERS has usable keys. SCREENER_LLM_KEY is ALSO the
# validation-checked key the interpreter needs (validate_config warns if
# missing) — a fresh deploy that sets ONLY the provider keys above still
# needs it unless a fallback provider is configured.
LLM_BASE_URL="https://zenmux.ai/api/v1"
LLM_MODEL="z-ai/glm-4.7-flash-free"
SCREENER_LLM_KEY=""          # Used by the NL interpreter (Layer 1)

# ── PostgreSQL Database (Primary Screener Database) ──────────────────────────
# A direct PostgreSQL connection string. Works with any provider:
#
#   Neon:      postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb
#   Supabase:  postgresql://postgres.ref:password@aws-0-us-west-1.pooler.supabase.com:5432/postgres
#   Railway:   postgresql://user:password@containers-us-west-xxx.railway.app:5432/railway
#   Local:     postgresql://localhost:5432/stratoscan
#
DATABASE_URL=""

# ── Rate Limiting ───────────────────────────────────────────────────────────
# RATE_LIMIT_ENABLED: master switch for the API rate limiter (default: true).
# Set to "false" only for local development / heavy test suites — keep ON in
# production.
RATE_LIMIT_ENABLED="true"
# Per-IP DEFAULT caps for the generic "read" bucket (every endpoint that isn't
# explicitly scoped to a tighter bucket). Production defaults: 60/min,
# 1,000/day (weekly = 5x daily). The LLM/Finnhub-costly scopes (screen 5/min,
# enrich 3/min, backtest 2/min, refresh 1/min, register 3/min) are cost
# shields and keep their own caps in src/api.py (RATE_LIMITS) — these two
# vars only move the per-IP default, not the per-scope shields.
RATE_LIMIT_PER_MINUTE="60"
RATE_LIMIT_PER_DAY="1000"
# RATE_LIMIT_BYPASS_IPS: comma-separated IPs EXEMPT from ALL rate limiting 
# (per-IP AND global buckets — whitelisted client skips the limiter 
# entirely). Local dev / testing escape hatch; keep empty in production.
RATE_LIMIT_BYPASS_IPS=""

# ── Upstash Redis (exact cross-worker rate limiting) ────────────────────────
# Enables the Redis-backed rate-limit store in src/redis_ratelimit.py: every
# uvicorn worker shares ONE counter (slowapi's in-memory counters were
# per-process, so multi-worker limits got looser). Falls back to the in-memory
# store if Redis is unreachable, so a Redis outage never breaks the API.
#   REDIS_RATE_LIMIT_ENABLED="true" + these two vars -> Redis backend
#   REDIS_RATE_LIMIT_ENABLED="false"                -> in-memory backend
# Get the URL + token from your Upstash console (REST API section).
REDIS_RATE_LIMIT_ENABLED="false"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Seconds per REST call to Upstash (default 10.0). One slow Redis round-trip
# never serializes the API — the middleware runs check_many off the event loop.
#REDIS_RATE_LIMIT_TIMEOUT=10.0

# ── Logging ──────────────────────────────────────────────────────────────────
# LOG_LEVEL: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
# LOG_FORMAT: "text" for colored console, "json" for structured JSON (default: text)
# LOG_FILE: Optional path to a log file (rotated at 10MB, JSON format)
LOG_LEVEL="INFO"
LOG_FORMAT="text"
LOG_FILE=""

# ── Supabase (optional — kept for future frontend use) ───────────────────────
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""
SUPABASE_ANON_KEY=""

# ── News Pipeline (dedicated key + separate news DB) ────────────────
# Dedicated Finnhub key used ONLY for /company-news so news fetching never
# competes with the screener quote/profile refresh. If it rate-limits, the
# fetcher falls back to the shared pool automatically.
# NEWS_DATABASE_URL is a SEPARATE Neon project storing news articles and
# LLM-scored sentiment (Finnhub /news-sentiment is paid-tier on free keys).
NEWS_FINNHUB_KEY=""
NEWS_DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
NEWS_SYMBOLS_LIMIT=150        # top-by-market-cap stocks refreshed per cycle
NEWS_REFRESH_MINUTES=120      # news refresh cadence (minutes)
NEWS_LLM_PREFER="groq"        # sentiment provider tried first (groq/gemini/zai)
                                 # groq/gemini answer <2s; zai can be slow on JSON

# ── London Strategic Edge (optional alternative history source) ─────────────
# Official market-data API with a free key: US stock history back to 2003,
# 10 exports/hour at up to 1,000,000 rows each. Used ONLY to backfill the
# backtest database (src/lse_source.py) — unset means nothing changes and
# yfinance stays the sole history source.
#
# ⚠️  LICENCE: LSE permits use for "your own research, trading and model
# training, including for commercial purposes" but FORBIDS redistributing the
# data or making it available to third parties. Backfilling your own backtest
# DB is permitted; serving LSE prices to end users is not. Do not wire this
# into the screener or any user-facing price display.
#
# ⚠️  LSE candles are RAW/unadjusted — dividends and splits are separate
# datasets. src/lse_source.py rebuilds the adjusted series; run
# verify_lse_vs_yfinance.py with a real key to prove it matches before
# trusting any backfill made with it.
LSE_API_KEY=""
LSE_TIMEOUT=60

# ── Backtesting Database (separate Neon project) ───────────────────
# 10 years of yfinance OHLCV + cached backtest results. Production storage
# is a DEDICATED Neon project (shared across instances, survives redeploys)
# — the old local SQLite file is a dev-only fallback when this is unset.
BACKTEST_DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"
# Dev-only SQLite fallback path used when BACKTEST_DATABASE_URL is unset
# (single-writer, lost on redeploy — NEVER point production at it).
#BACKTEST_DB_PATH=./data/backtest_history.db

# ── Authentication (JWT, stdlib-only — no external packages) ─────
# Secret used to sign auth tokens. REQUIRED for /auth/* endpoints.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRE_HOURS=168
PASSWORD_MIN_LENGTH=8
PASSWORD_RESET_TOKEN_TTL_MINUTES=45        # reset link lifetime (30–60 recommended)

# ── Timeouts ───────────────────────────────────────────────────────────
# Per-LLM-call timeout. Free flash models (GLM-4.5/4.7) legitimately take
# 42-135s on strict-JSON prompts — keep this generous. Override per provider
# with <NAME>_TIMEOUT (e.g. ZAI_TIMEOUT=180, GROQ_TIMEOUT=30).
LLM_PROVIDER_TIMEOUT=120
# Per-Finnhub-request timeout (the SDK defaults every request to 10s).
FINNHUB_REQUEST_TIMEOUT=30
# Budget for 10-year yfinance OHLCV downloads in the backtester.
YFINANCE_TIMEOUT=60
# Postgres connect timeout for the /health probe (Neon cold start >3s).
DB_CONNECT_TIMEOUT=15

# ── Caching ────────────────────────────────────────────────────────
# In-memory TTL caches (src/cache.py). INTERPRET caches the LLM result of a
# query (24h TTL — identical queries never burn a free LLM call again).
# SCREEN caches full /screen responses (60s TTL — instant repeat hits while
# staying fresh against the 10-minute universe refresh).
CACHE_ENABLED=true
INTERPRET_CACHE_TTL=86400
INTERPRET_CACHE_MAX_ENTRIES=1024
SCREEN_CACHE_TTL=60
SCREEN_CACHE_MAX_ENTRIES=1024

# ── NL interpreter (hybrid deterministic + LLM) ────────────────────
# When true (default), src/deterministic_interpreter.py parses the query
# first; if it scores >= 0.6 confidence the result is used as-is — sub-ms
# and zero LLM cost, which covers most queries. Only lower-confidence or
# fuzzy queries fall through to the LLM. Set false to always use the LLM
# (slower, burns free-tier quota — useful when debugging the LLM path).
USE_DETERMINISTIC_INTERPRETER=true

# ── CORS (browser security) ─────────────────────────
# Comma-separated allowed browser origins. Dev defaults cover local frontends;
# PRODUCTION MUST set this to your real frontend origin (e.g. Vercel):
#   CORS_ALLOW_ORIGINS=https://your-app.vercel.app
# A wildcard "*" will NOT work with credentialed requests — be explicit.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# No paywall: Stratoscan is fully free — no billing layer.
# ── Background Job Monitoring ──────────────────────────────
# Records every scheduler job run (job_runs table: status, duration, record
# count, error) + a throttled scheduler heartbeat so a silently-dead refresh
# is never missed. Exposed via GET /ops/jobs and GET /ops/jobs/{job_name}.
# The heartbeat persists at most every JOB_HEARTBEAT_PERSIST_MINUTES so Neon
# can still auto-suspend between refresh cycles (writing every 30s tick would
# keep serverless compute awake 24/7). "Scheduler alive" = 3x that interval.
# In-memory fallback when DATABASE_URL is unset — monitoring never breaks a job.
JOB_MONITOR_ENABLED=true
JOB_HEARTBEAT_PERSIST_MINUTES=15

# ── Backtest Cache Warmer ──────────────────────────────
# Pre-fetches 10 years of yfinance OHLCV for the screener's top-N stocks
# (by market cap) into the backtest DB, so a premium backtest never waits
# on a cold yfinance download at request time. The nightly scheduler job
# runs at BACKTEST_CACHE_WARMER_TIME (local, before the US open); it only
# runs when BACKTEST_DATABASE_URL is set (SQLite dev stays on-demand).
# One-time run: python -m src.main warm-cache
BACKTEST_CACHE_WARMER_ENABLED=true
BACKTEST_CACHE_WARMER_LIMIT=100
BACKTEST_CACHE_WARMER_STALE_DAYS=2
BACKTEST_CACHE_WARMER_DELAY=0.2
BACKTEST_CACHE_WARMER_TIME=03:30

# ── Email verification (SendGrid Web API) ────────────────────────────────
# New accounts get a verification link (stdlib-only client in src/emails.py —
# no SDK dependency). EMAIL_FROM_ADDRESS must be a SENDER VERIFIED in the
# SendGrid dashboard, or SendGrid rejects the mail with 403.
SENDGRID_API_KEY=""                        # Web API key ("SG.xxx")
EMAIL_FROM_ADDRESS=""                      # a sender verified in SendGrid
# APP_BASE_URL — public origin used to build the emailed verification link
# (http://localhost:3000 in dev, https://app.stratoscan.com in prod). The
# link points at your frontend, which then calls GET /auth/verify-email.
APP_BASE_URL="http://localhost:3000"
EMAIL_VERIFICATION_REQUIRED=false          # true blocks unverified logins (403)
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24      # link expires after 24h

# ── SMTP transport (SMTP_HOST is the switch) ─────────────────────────────
# An alternative to the SendGrid API for the SAME mail (verification links,
# and alert emails via src/alerts.py). src/emails.py picks the transport on
# SMTP_HOST alone: non-empty sends over SMTP and the SendGrid keys above are
# ignored; blank keeps the SendGrid API. The return contract is identical,
# so nothing else in the app needs to know which one ran.
#
# Blank in production. The local docker compose stack sets it to its mailpit
# service (SMTP_HOST="mailpit", SMTP_PORT=1025) so the signup mail path can
# be exercised end to end — token and all — with no SendGrid account.
SMTP_HOST=""                               # non-empty = send over SMTP, not SendGrid
SMTP_PORT=1025                             # mailpit's port; relays usually 587
SMTP_USERNAME=""                           # blank = no AUTH (mailpit, local relays)
SMTP_PASSWORD=""                           # only read when SMTP_USERNAME is set
SMTP_STARTTLS=false                        # true upgrades the connection before AUTH

# ── Admin Dashboard (operator role) ─────────────────────────────
# Comma-separated emails promoted to admin automatically at login
# (PATCH /admin/users/{id} can also grant it manually). Without this
# list, /admin + /admin/* return 403 to everyone. No rows are created
# by migrations — admins are granted via env or the admin API.
ADMIN_EMAILS=you@stratoscan.com

# ── Deployment environment ────────────────────────────────────────────
# "development" (default) or "production". In production the interactive
# API docs (Swagger UI / ReDoc / OpenAPI schema) are DISABLED. Set
# APP_ENV=production in the deployed environment.
APP_ENV=development

# ── Observability & Alerting (Tier 2 ops) ───────────────────────────────
# Two delivery channels — at least one must be set or alerting is a no-op.
# ALERT_WEBHOOK_URL: a Slack/Discord/ntfy-compatible incoming webhook
# (preferred when set; fire-and-forget POST, throttled per key).
# Leave empty to use the email channel instead.
#ALERT_WEBHOOK_URL="https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX"
# ALERT_EMAIL: recipient for alert emails (used when no webhook is set).
# Requires the SendGrid sender too (SENDGRID_API_KEY + EMAIL_FROM_ADDRESS
# above) — the same stdlib-only client that sends verification emails.
#ALERT_EMAIL="ops@stratoscan.com"
# Min seconds between alerts for the SAME key (alert-storm guard). Default 900 (15 min).
#ALERT_WEBHOOK_MIN_INTERVAL_SECONDS=900
# /metrics: Prometheus text-format endpoint (stdlib exporter, near-zero cost).
#METRICS_ENABLED=true
# SENTRY_DSN — error-monitoring DSN. Injected by the deploy workflow; the
# backend does not send events yet (Sentry is frontend-only via VITE_SENTRY_DSN),
# kept here so the app's env contract and the CI/CD secrets match 1:1.
#SENTRY_DSN="https://xxxx@o123.ingest.sentry.io/123"
