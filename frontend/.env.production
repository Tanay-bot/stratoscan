# Stratoscan frontend — PRODUCTION build defaults.
# This file IS committed on purpose: it pins the safe defaults for any
# `vite build`. Vite's env resolution order is:
#   .env < .env.local < .env.[mode] < .env.[mode].local
# so .env.production overrides a developer's .env.local, and the
# demo-mode guard in vite.config.ts reads the same resolved value.
# The bundle and the guard can therefore never disagree.

# Demo mode MUST be off in production. The build-time guard fails the
# build if this is ever true in a production build.
VITE_DEMO_MODE=false

# Public site origin — used for canonical URLs, OG/Twitter image paths, and
# the SEO manager (src/lib/seo.ts). Override at deploy time if the real
# domain differs (Vite env resolution order: .env < .env.local < .env.production
# < .env.production.local).
VITE_SITE_URL=https://stratoscan.com

# Backend API base URL. Set this to your deployed backend origin at
# deploy time (Cloudflare Pages env var overrides this file):
#   VITE_API_URL=https://api.stratoscan.com
# Leaving it unset means the app will call the same origin (/api) — which
# is correct for same-origin reverse-proxy setups.
