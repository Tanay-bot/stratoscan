# Stratoscan frontend — environment reference.
# Copy to .env and adjust. Vite only exposes VITE_* vars to the client bundle.

# Backend API base URL.
#   Dev default: relative "/api" → proxied by Vite to http://localhost:8000
#   (zero CORS). Or set an absolute URL to hit the backend directly, e.g.
#   VITE_API_URL=http://localhost:8000
#   Prod: set to your deployed backend origin, e.g.
#   VITE_API_URL=https://api.stratoscan.com
VITE_API_URL=/api

# Public site origin — used for canonical URLs, OG/Twitter image paths, and
# the SEO manager (src/lib/seo.ts). Defaults to https://stratoscan.com.
# Set this to your real Vercel domain at deploy time, e.g.
#   VITE_SITE_URL=https://stratoscan.com
VITE_SITE_URL=https://stratoscan.com

# Demo mode serves realistic synthetic data through the same typed API
# interface so the UI is fully demoable without a running backend.
# Off by default (real API). Set to true for a backend-free preview.
VITE_DEMO_MODE=false

# Price flag (Day 12). No price renders anywhere in the UI unless BOTH are
# set: the flag on AND a display string for Pro. Leave off until Pro is for
# sale; pricing.test.tsx fails if a price leaks while it is off.
VITE_PRICING_ENABLED=false
# VITE_PRO_PRICE=

# Sentry error monitoring (https://sentry.io). Leave empty to disable.
# Enable in production: create a Sentry project (React), copy the DSN
# (Settings → Client Keys), and set it here or in the deploy platform env
# vars. The DSN is a public identifier, not a secret — safe to commit.
VITE_SENTRY_DSN=

# ── Sentry sourcemap upload (build-time, SERVER-side env — never a VITE_* var) ──
# Set these in CI / your deploy platform (Vercel/Fly/GitHub Actions secrets).
# When SENTRY_AUTH_TOKEN is present, `npm run build` uploads sourcemaps to
# Sentry for readable production stack traces, then deletes dist/**/*.map.
# When it's absent, the plugin is skipped entirely and builds succeed locally.
#
# SENTRY_ORG and SENTRY_PROJECT must match your Sentry org slug and project
# slug (Settings → Projects → your project → General Settings).
#
#   SENTRY_ORG=stratoscan
#   SENTRY_PROJECT=stratoscan-frontend
#   SENTRY_AUTH_TOKEN=sntrys_...   (Settings → Auth Tokens → Create New Token,
#                                   scopes: project:releases + project:write)
#
# Optional: pin the release name (defaults to "dev"). The same value is
# injected into the bundle and used by the sourcemap upload, so events and
# maps always associate. Set to your git SHA or semver tag in CI:
#
#   VITE_RELEASE_VERSION=2026.08.1
